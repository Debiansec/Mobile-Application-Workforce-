# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# WORKFORCE HEALTH SA Cloud Backend Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_STORAGE_BUCKET=inspection-evidence

# WORKFORCE HEALTH SA Central Office Administration Integration
# Target Office Portal: https://workforce-health-sa-m28gog.v2.appdeploy.ai/
# Enter your secret API key securely in the Secrets panel in AI Studio
WORKFORCE_BACKEND_API_KEY=YOUR_WORKFORCE_BACKEND_API_KEY
WORKFORCE_BACKEND_URL=https://workforce-health-sa-m28gog.v2.appdeploy.ai/
